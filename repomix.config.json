{
  "ignore": {
    "customPatterns": [
      "node_modules",
      ".next",
      ".env.local",
      "public",
      "repomix-output.*",
      "package-lock.json",
      "MDFILES",
      "**/tsconfig.tsbuildinfo",
      "**/public/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.svg",
      "**/*.ico"

    ]
  },

  "output": {
    "removeComments": true,
    "removeEmptyLines": true,
    "directoryStructure": false,
    "fileSummary": false
  }
}
