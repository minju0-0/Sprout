# Sprout — environment variables
# Copy to .env.local for local dev. Set the same keys in your hosting
# provider's dashboard for Production, Preview, and Development
# separately — Clerk, Supabase, and Sentry each have dev vs. prod instances.

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Supabase) ---
SUPABASE_URL=
# Server-only — never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Advisor (Gemini) ---
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash-lite if unset.
GEMINI_MODEL=

# --- Monitoring (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Needed for sourcemap upload at build time. Sourcemaps are silently
# disabled (not an error) if this is unset — see next.config.ts.
SENTRY_AUTH_TOKEN=

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App ---
# Your real production domain, e.g. https://sprout.app
NEXT_PUBLIC_APP_URL=
